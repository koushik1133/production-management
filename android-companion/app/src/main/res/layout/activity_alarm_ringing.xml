<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#dc2626"
    android:gravity="center">

    <TextView
        android:id="@+id/txtTabletName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔 FIND MY TABLET"
        android:textColor="#ffffff"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Production Manager is locating this tablet"
        android:textColor="#fee2e2"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btnStopSound"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🔇 STOP SOUND"
        android:backgroundTint="#ffffff"
        android:textColor="#dc2626"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
